{
  "info": {
    "name": "Brokerage",
    "description": "Portfolio, instrument search and orders of account 10001. Start the stack first with `docker compose up --build`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/brokerage-api"
    },
    {
      "key": "accountNumber",
      "value": "10001"
    }
  ],
  "item": [
    {
      "name": "Get portfolio",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/accounts/{{accountNumber}}/portfolio",
        "description": "Account 10001: availableCash 627500.00, totalValue 889756.00, positions BMA METR PAMP."
      }
    },
    {
      "name": "Search instruments",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/instruments?q=banco&page=0&pageSize=20",
        "description": "q=banco returns one page with BBAR, BHIP, BMA and BPAT in content, and totalElements 4. page starts at 0; pageSize goes from 1 to 100 and defaults to 20."
      }
    },
    {
      "name": "Market order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticker\": \"GGAL\",\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"size\": 1\n}"
        },
        "url": "{{baseUrl}}/v1/accounts/{{accountNumber}}/orders",
        "description": "Buys 1 GGAL at market. It is FILLED at the 885.80 close."
      }
    },
    {
      "name": "Market order by amount",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticker\": \"GGAL\",\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"amount\": \"2000.00\"\n}"
        },
        "url": "{{baseUrl}}/v1/accounts/{{accountNumber}}/orders",
        "description": "Invests up to 2000 pesos in GGAL: buys 2 shares at the 885.80 close. amount and price are sent as text; JSON numbers are accepted too. A MARKET order must not carry a price."
      }
    },
    {
      "name": "Limit order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticker\": \"GGAL\",\n  \"side\": \"BUY\",\n  \"type\": \"LIMIT\",\n  \"size\": 10,\n  \"price\": \"800.00\"\n}"
        },
        "url": "{{baseUrl}}/v1/accounts/{{accountNumber}}/orders",
        "description": "Buys 10 GGAL at 800.00. It stays NEW and reserves 8000.00."
      }
    },
    {
      "name": "Rejected for insufficient cash",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticker\": \"GGAL\",\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"size\": 1000000\n}"
        },
        "url": "{{baseUrl}}/v1/accounts/{{accountNumber}}/orders",
        "description": "A buy the account cannot afford. Answers 201 with status REJECTED and leaves the portfolio unchanged."
      }
    },
    {
      "name": "Cancel open order",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/v1/accounts/{{accountNumber}}/orders/5/cancellation",
        "description": "On a freshly loaded database, the NEW limit buy of 50 LOMA at 710.00 has id 5."
      }
    },
    {
      "name": "List open orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/accounts/{{accountNumber}}/orders?status=NEW&page=0&pageSize=20",
        "description": "Orders of the account, oldest first, by page. status is optional (NEW, FILLED, REJECTED, CANCELLED); page starts at 0 and pageSize goes from 1 to 100 (default 20). The response carries content, page, pageSize, totalElements and totalPages."
      }
    }
  ]
}
